# API Keys (provide at least one)
# Priority: If both are set, OPENAI_API_KEY will be used
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Phase 2: Claim Submission Configuration
# URL for Optum Bank claim submission form
OPTUM_URL=https://account.optumbank.com/account/expenses/new?expense-type=reimbursement
# Claude model for claim submission agent (requires Anthropic API key)
CLAIM_MODEL=claude-sonnet-4-5-20250929
# Maximum retry attempts per claim on error
MAX_CLAIM_RETRIES=3
# Run browser in headless mode (true/false)
BROWSER_HEADLESS=false
# Timeout for user intervention in seconds
INTERVENTION_TIMEOUT=300
